{
  "name": "auralis",
  "version": "1.18.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "Auralis — a self-hosted, local-first music platform (sandbox dev port 3000).",
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "deploy:up": "bash deploy/update.sh",
    "deploy:backup": "bash deploy/backup.sh",
    "db:push": "echo 'auralis uses its own sqlite migrations (src/server/db.ts)'"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "music-metadata": "^11.13.0",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^3.4.19"
  },
  "overrides": {
    "postcss": "^8.5.15"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
