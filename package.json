{
  "name": "auralis",
  "version": "1.14.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "Auralis — a self-hosted, local-first music platform: SQLite library with real tag/metadata extraction, secure range streaming, cover-art cache, and automatic lyric fetching (LRCLIB) saved back as .lrc sidecars. Ships as a web app, an Electron desktop app (Debian/Windows) and an Android client.",
  "homepage": "https://github.com/ybenyedder/auralis",
  "main": "desktop/main.js",
  "author": {
    "name": "Youssef Ben yedder",
    "email": "volt@webtvmedia.net"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/ybenyedder/auralis.git"
  },
  "bugs": {
    "url": "https://github.com/ybenyedder/auralis/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://paypal.me/AdamMezerai"
  },
  "scripts": {
    "dev": "next dev -p 4237",
    "build": "next build",
    "start": "NODE_ENV=production next start -p 4237",
    "serve": "NODE_ENV=production node .next/standalone/server.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true next build",
    "check": "npm run lint && npm run typecheck && npm run build",
    "desktop:dev": "AURALIS_DESKTOP_DEV=1 electron desktop/main.js",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:build": "npm run build && npm run desktop:prepare && electron-builder",
    "desktop:build:linux": "npm run build && npm run desktop:prepare && electron-builder --linux",
    "desktop:build:win": "npm run build && npm run desktop:prepare && electron-builder --win",
    "mobile:native": "node scripts/build-native-apk.mjs",
    "migrate:status": "tsx scripts/migrate-status.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.525.0",
    "music-metadata": "^11.13.0",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@next/bundle-analyzer": "^16.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^42.6.0",
    "electron-builder": "^26.15.6",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "jsdom": "^22.1.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.22.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.15"
  }
}
