# =============================================================================
# Auralis — configuration du serveur (copier ce fichier en .env puis adapter)
#     cp .env.example .env
#
# Règles générales :
#   - une valeur vide ou une ligne commentée => valeur par défaut ;
#   - les booléens acceptent 1 / true / yes / on (insensible à la casse) ;
#   - après modification : ./update.sh  (le conteneur est recréé).
# =============================================================================

# --- Compte administrateur ---------------------------------------------------

# Mot de passe du compte « admin » créé au PREMIER démarrage uniquement
# (6 caractères minimum). Changé ensuite depuis l'application ; cette variable
# n'a plus d'effet une fois le compte créé.
AURALIS_ADMIN_PASSWORD=changez-moi

# --- Réseau ------------------------------------------------------------------

# Port exposé SUR LE SERVEUR (le conteneur écoute toujours en interne sur
# 3000). Si vous le changez, pensez à adapter le reverse proxy.
AURALIS_PORT=3000

# URL publique exacte du serveur (avec https:// et sans barre finale), une fois
# le reverse proxy en place — ex. : https://musique.exemple.tld. Sert aux
# métadonnées de partage (aperçu des liens, og:image) et aux icônes absolues.
# Vide = http://localhost:3000.
#AURALIS_PUBLIC_URL=https://musique.exemple.tld

# Jeton d'API statique (bearer) donnant les droits administrateur sans mot de
# passe — utile pour un client Android/de bureau sur le réseau local. Vide =
# désactivé. Choisissez une longue chaîne aléatoire et gardez-la secrète.
#AURALIS_TOKEN=

# Origines autorisées pour les requêtes modifiant des données derrière un
# reverse proxy qui réécrit les en-têtes (liste séparée par des virgules,
# ex. : https://musique.exemple.tld). Vide = comportement par défaut.
#AURALIS_ALLOWED_ORIGINS=

# --- Dossiers (ne pas modifier avec Docker) ----------------------------------

# Déjà définis par l'image sur /music et /data, montés depuis ./deploy/music
# et ./deploy/data par docker-compose.yml. Ne les redéfinissez pas ici.
#AURALIS_MUSIC_DIR=/music
#AURALIS_DATA_DIR=/data

# --- Paroles -----------------------------------------------------------------

# Autoriser le serveur à interroger LRCLIB sur internet (false = mode hors-ligne).
#AURALIS_LYRICS_ONLINE=true

# Interroger aussi Musixmatch pour des paroles karaoké mot à mot.
#AURALIS_LYRICS_MUSIXMATCH=true

# Base de paroles en ligne (un miroir LRCLIB auto-hébergé est possible).
#AURALIS_LYRICS_ENDPOINT=https://lrclib.net

# Repli sans clé utilisé quand LRCLIB n'a rien (vide = désactivé).
#AURALIS_LYRICS_FALLBACK=https://api.lyrics.ovh

# Écrire les paroles téléchargées dans un fichier .lrc à côté du morceau
# (mode auto-hébergé : la deuxième écoute ne retélécharge rien).
#AURALIS_LYRICS_SIDECAR=true

# Alignement forcé local mot à mot (expérimental, nécessite Python + torch).
#AURALIS_LYRICS_FORCED_ALIGN=false

# --- Analyse de la bibliothèque ----------------------------------------------

# Nombre maximal de fichiers analysés en un passage (garde-fou).
#AURALIS_MAX_SCAN_FILES=200000

# Profondeur maximale de récursion des dossiers.
#AURALIS_MAX_SCAN_DEPTH=12

# Surveiller le dossier /music et relancer un scan à chaque modification
# (fichiers ajoutés/supprimés par un autre programme). 1 = activé.
#AURALIS_WATCH=1

# Avec un montage réseau (NAS/NFS/SMB), inotify ne voit rien : activer
# l'interrogation périodique du dossier à la place.
#AURALIS_WATCH_POLL=0

# Période d'interrogation en millisecondes (uniquement si AURALIS_WATCH_POLL=1).
#AURALIS_WATCH_POLL_INTERVAL=30000

# --- Application Android (Google Play) ---------------------------------------

# Nom du package Android déclaré dans Play Console — active la déclaration
# /.well-known/assetlinks.json (voir PLAYSTORE.md). Vide = désactivé.
#AURALIS_PLAYSTORE_PACKAGE=app.exemple.auralis

# Empreinte SHA-256 du certificat de signature de l'application Android
# (format keytool AA:BB:... ou hexadécimal simple).
#AURALIS_PLAYSTORE_FINGERPRINT=

# --- Journaux ----------------------------------------------------------------

# Niveau de journalisation : debug, info, warn ou error.
#AURALIS_LOG_LEVEL=info

# Format des journaux : json (défaut en production) ou texte lisible.
#AURALIS_LOG_FORMAT=json
