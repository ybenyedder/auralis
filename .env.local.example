# =============================================================================
# Auralis — configuration de développement (copier en .env.local puis adapter)
#     cp .env.local.example .env.local
# Liste complète des variables : deploy/.env.example
# =============================================================================

# Dossier contenant votre musique (relatif ou absolu).
AURALIS_MUSIC_DIR=./music

# Dossier de données : base SQLite, pochettes extraites, analyses audio.
AURALIS_DATA_DIR=./data

# Mot de passe initial du compte admin (au premier démarrage uniquement).
AURALIS_ADMIN_PASSWORD=changez-moi

# Mettre false pour un mode 100 % hors-ligne (aucune requête de paroles).
AURALIS_LYRICS_ONLINE=true

# Surveiller le dossier musique et re-scanner à chaque modification.
AURALIS_WATCH=1
